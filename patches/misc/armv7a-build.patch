Subject: Build for 32-bit ARM only

---
 TMessagesProj/build.gradle     | 2 +-
 TMessagesProj_App/build.gradle | 8 +++++---
 2 files changed, 6 insertions(+), 4 deletions(-)

diff --git a/TMessagesProj/build.gradle b/TMessagesProj/build.gradle
index 0000000..0000000 100644
--- a/TMessagesProj/build.gradle
+++ b/TMessagesProj/build.gradle
@@ -248,7 +248,7 @@ android {
         targetSdkVersion 36
 
         ndk {
-            abiFilters "arm64-v8a"
+            abiFilters "armeabi-v7a"
         }
 
         externalNativeBuild {
diff --git a/TMessagesProj_App/build.gradle b/TMessagesProj_App/build.gradle
index 0000000..0000000 100644
--- a/TMessagesProj_App/build.gradle
+++ b/TMessagesProj_App/build.gradle
@@ -119,7 +119,7 @@ android {
         ndkVersion "29.0.14206865"
 
         ndk {
-            abiFilters "arm64-v8a"
+            abiFilters "armeabi-v7a"
         }
 
         if (!rootProject.ext.inuPluginless) externalNativeBuild {
@@ -175,6 +175,8 @@ tasks.matching { it.name ==~ /merge.*JniLibFolders/ }.configureEach {
     dependsOn 'unpackShadowhook'
 }
 
+def inuAbi = android.defaultConfig.ndk.abiFilters.single()
+
 def rustModuleDir = file("$projectDir/native")
 def rustJniLibsDir = file("$buildDir/rustJniLibs")
 def userHome = System.getProperty('user.home')
@@ -199,7 +201,7 @@ inuNativeProfiles.each { buildType, cargoProfile ->
     def taskName = "buildInuNative${buildType.capitalize()}"
     def outputDir = new File(rustJniLibsDir, buildType)
     def stockJniTask = "copy${buildType.capitalize()}JniLibsProjectOnly"
-    def stockLib = project(':TMessagesProj').file("build/intermediates/library_jni/$buildType/$stockJniTask/jni/arm64-v8a/libtmessages.49.so")
+    def stockLib = project(':TMessagesProj').file("build/intermediates/library_jni/$buildType/$stockJniTask/jni/${inuAbi}/libtmessages.49.so")
     def sqliteLinkDir = file("$buildDir/inuSqliteLink/$buildType")
     tasks.register(taskName, Exec) {
         dependsOn ":TMessagesProj:$stockJniTask"
@@ -229,7 +231,7 @@ inuNativeProfiles.each { buildType, cargoProfile ->
             d.isDirectory() && d.listFiles()?.any { it.name ==~ /libclang\.(dylib|so)(\..*)?/ }
         }
         if (libclangDir != null) environment 'LIBCLANG_PATH', libclangDir
-        commandLine cargoExe, 'ndk', '-t', 'arm64-v8a', '-o', outputDir.absolutePath, 'build', '--profile', cargoProfile
+        commandLine cargoExe, 'ndk', '-t', inuAbi, '-o', outputDir.absolutePath, 'build', '--profile', cargoProfile
     }
 
     android.sourceSets[buildType].jniLibs.srcDirs += outputDir
